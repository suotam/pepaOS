NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
OPENAI_API_KEY=your_openai_api_key

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Optional: customize session user ID (for testing, default uses random UUID)
# Session user ID should match the user_id in your connected_accounts table
SESSION_USER_ID=test-user-123

# Optional: absolute or relative path to an official CUZK / RUIAN address CSV export.
# When set, new and updated properties will be geocoded against the official dataset.
# RUIAN_CSV_PATH=./data/ruian-addresses.csv
